# Copia este archivo como .env.local y pega tu anon key real.
#   cp .env.example .env.local
#
# La anon key está en: Supabase → Project Settings → API → "anon public".
# .env.local NUNCA se sube al repositorio (está en .gitignore).

VITE_SUPABASE_URL=https://qztxpcfbbbmvgmtjnlxg.supabase.co
VITE_SUPABASE_ANON_KEY=PEGA_AQUI_TU_ANON_KEY

# Llave PÚBLICA de VAPID para las notificaciones push del navegador.
# Se genera una sola vez con:  npx web-push generate-vapid-keys
# La PRIVADA no va aquí: se guarda como secreto de la Edge Function.
VITE_VAPID_PUBLIC_KEY=
